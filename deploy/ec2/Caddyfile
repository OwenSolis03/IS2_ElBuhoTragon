# __HOST__ lo reemplaza setup.sh por el dominio del backend.
# Caddy obtiene y renueva solo el certificado HTTPS (Let's Encrypt).

{
	servers {
		# Las peticiones llegan por el proxy de Amplify (CloudFront -> proxy -> Caddy).
		# Se conserva X-Forwarded-For para que Django vea la IP del alumno y no la del
		# proxy (con NUM_PROXIES=3); sin esto todos compartirían el mismo límite por IP.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

__HOST__ {
	encode gzip

	# Archivos estáticos del admin de Django (collectstatic)
	handle_path /static/* {
		root * /opt/buho/current/backend/staticfiles
		file_server
	}

	reverse_proxy 127.0.0.1:8000

	header {
		-Server
		Strict-Transport-Security "max-age=3600"
		X-Content-Type-Options nosniff
	}
}
