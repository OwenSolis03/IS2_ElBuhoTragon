# Copia este archivo como backend/.env y ajusta los valores.
# backend/.env está en .gitignore: nunca lo subas al repo.

# --- Desarrollo local ---
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY se puede omitir con DEBUG=True

# --- Producción (EC2) ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=genera-una-con: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_ALLOWED_HOSTS=api.tudominio.com
# CORS_ALLOWED_ORIGINS=https://main.xxxxxxxx.amplifyapp.com
# NUM_PROXIES=1

# --- Chatbot (Amazon Bedrock) ---
# RAG_BACKEND=bedrock          (hpc = Qwen en el clúster Yuca)
# BEDROCK_REGION=us-east-2
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# En local: AWS_PROFILE=buho-tragon (en EC2 se usa el rol de la instancia)

# --- Límites de peticiones (control de costo de Bedrock) ---
# THROTTLE_LOGIN=10/minute
# THROTTLE_REGISTRO=5/hour
# THROTTLE_CHATBOT=30/hour
# THROTTLE_CHATBOT_GLOBAL=400/day   (~$0.0015 por mensaje con Nova 2 Lite)
