# Copia este archivo a backend/.env y ajusta los valores. No subas .env a git.

# Obligatoria fuera de DEBUG. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# true solo en tu máquina de desarrollo (muestra páginas de error con detalles internos)
DJANGO_DEBUG=false

# Hosts desde los que se sirve el backend, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Proxies de confianza delante de Django (0 = conexión directa / túnel SSH; 1 = detrás de nginx)
DJANGO_NUM_PROXIES=0
